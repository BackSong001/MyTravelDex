{
  "expo": {
    "name": "여행가봥",
    "slug": "mytraveldex",
    "scheme": "mytraveldex",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./public/lavender-backpack.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "orientation": "default",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.mytraveldex.app",
      "permissions": ["android.permission.CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-adaptive.png",
        "backgroundColor": "#C9C6F4"
      },
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "여행 사진을 선택해 기록에 추가합니다.",
          "cameraPermission": "포토 버튼을 눌렀을 때 여행 사진을 촬영합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "사진의 촬영일과 위치를 여행 기간·대표 위치에 적용합니다.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-web-browser"
    ]
  }
}
