{
  "expo": {
    "name": "여행가봥",
    "slug": "mytraveldex",
    "scheme": "mytraveldex",
    "version": "1.0.0",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F2"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.mytraveldex.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", {"photosPermission":"여행 사진을 선택해 기록에 추가합니다.","cameraPermission":false,"microphonePermission":false}],
      ["expo-media-library", {"photosPermission":"사진의 촬영일과 위치를 여행 기간·대표 위치에 적용합니다.","isAccessMediaLocationEnabled":true,"granularPermissions":["photo"]}],
      "expo-web-browser"
    ]
  }
}
