{
  "framework": null,
  "installCommand": "npm ci && npm --prefix frontend ci",
  "buildCommand": "node scripts/export-web.mjs",
  "outputDirectory": "frontend/dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(auth/callback|explore/random|login|home|map|feed|dex|record/new|record/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})/?",
      "dest": "/index.html"
    }
  ]
}
