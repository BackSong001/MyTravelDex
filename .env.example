# 팀원 공유용: 아래 Supabase URL/공개 키와 Google Web/Android Client ID는 실제 공개 설정이다.
# 이 설정은 현재 공유 프로젝트에 연결된다. 테스트 기록도 같은 서버에 저장될 수 있다.
# 격리 테스트는 README.local.md의 Local Supabase 설정을 사용한다. 서버 비밀값은 별도로 전달한다.
# 공개 클라이언트 값. EXPO_PUBLIC_*에는 서버 Secret을 넣지 않는다.
EXPO_PUBLIC_SUPABASE_URL=https://iopnsmxobqcqgkyanesa.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_u9X-Y02idbrhGteb4ITExA_5XnN_Mnh
# Deprecated: 현재 SVG 지도에서 아래 Google 지도 key 3개는 미사용. 기존 도구 호환용으로 보존한다.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=your_restricted_web_maps_api_key
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=your_restricted_android_maps_api_key
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=your_restricted_ios_maps_api_key
EXPO_PUBLIC_APP_ENV=local

# OAuth Client ID는 공개 식별자이며 Client Secret과 다르다. 미설정 iOS는 예시값을 유지한다.
GOOGLE_OAUTH_CLIENT_ID_WEB=485921854698-rpne1k1maeb5e7j5rbi2q3op9hr22tqd.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID_ANDROID=485921854698-ug7l16o4o1mvhm8o7h6qrkjhjqof3ivh.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID_IOS=your_ios_oauth_client_id
# 서버 전용 값. 예시값을 유지하며 클라이언트 번들/Git에 실제 값을 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
# Deprecated: 과거 Google 검사 도구 전용. 현재 geocode-location은 GEOAPIFY_API_KEY를 사용한다.
GOOGLE_MAPS_SERVER_API_KEY=your_restricted_server_maps_api_key
SUPABASE_PROJECT_REF=your_supabase_project_ref
SUPABASE_DB_PASSWORD=your_supabase_database_password

# 환경별 Redirect URL. Google OAuth는 지도 공급자와 별개로 유지한다.
GOOGLE_OAUTH_REDIRECT_URL_LOCAL=http://127.0.0.1:54321/auth/v1/callback
GOOGLE_OAUTH_REDIRECT_URL_TEST=https://your-test-domain.example/auth/callback
GOOGLE_OAUTH_REDIRECT_URL_PRODUCTION=https://your-production-domain.example/auth/callback

# Geoapify 장소 검색: Supabase Edge Function Secret 전용. 실제 값은 예시에 기록하지 않는다.
GEOAPIFY_API_KEY=your_geoapify_server_key

# Android 로컬 AAB 빌드 전용. 실제 값은 저장소 밖 보안 파일/CI 환경에서 제공한다.
# android:bundle은 EXPO_PUBLIC_APP_ENV=production을 명시해야 한다.
ANDROID_UPLOAD_STORE_FILE=/absolute/path/outside/repository/upload-keystore.jks
ANDROID_UPLOAD_STORE_PASSWORD=your_upload_store_password
ANDROID_UPLOAD_KEY_ALIAS=your_upload_key_alias
ANDROID_UPLOAD_KEY_PASSWORD=your_upload_key_password
